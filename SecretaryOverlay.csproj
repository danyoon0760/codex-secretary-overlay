<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StartupObject>SecretaryOverlay.Program</StartupObject>
    <RootNamespace>SecretaryOverlay</RootNamespace>
    <!-- Only sources under src/ are compiled, so stray local files never leak into a build. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- The UI is Korean; skip framework resource folders for other languages. -->
    <SatelliteResourceLanguages>ko</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup Label="Product">
    <Version>0.2.0</Version>
    <Product>Secretary Overlay</Product>
    <Description>Windows desktop pet overlay for Codex task notifications</Description>
    <Authors>danyoon0760</Authors>
    <Copyright>Copyright (c) 2026 danyoon0760</Copyright>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
    <Content Include="assets\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets\fonts\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
